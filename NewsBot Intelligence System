        "\n",
        "# mod 4, 5, 6, 8\n",
        "import spacy\n",
        "from nltk.sentiment.vader import SentimentIntensityAnalyzer\n",
        "from collections import Counter\n",
        "\n",
        "# load or force download spacy model\n",
        "try:\n",
        "    nlp = spacy.load(\"en_core_web_sm\")\n",
        "except OSError:\n",
        "    !python -m spacy download en_core_web_sm\n",
        "    nlp = spacy.load(\"en_core_web_sm\")\n",
        "\n",
        "# module 6 sentiment calculation loop\n",
        "print(\"running sentiment scores...\")\n",
        "sia = SentimentIntensityAnalyzer()\n",
        "df['sentiment_score'] = df['Text'].apply(lambda x: sia.polarity_scores(str(x))['compound'])\n",
        "\n",
        "# extract syntax, grammar, writing style patterns via counters\n",
        "print(\"building cross category analysis structures...\")\n",
        "samp = df.sample(n=150, random_state=42).copy()\n",
        "cats = df['Category'].unique()\n",
        "\n",
        "pos_map = {c: Counter() for c in cats}\n",
        "ner_map = {c: Counter() for c in cats}\n",
        "dep_relations = Counter()\n",
        "\n",
        "# deep parse loop\n",
        "for i, r in samp.iterrows():\n",
        "    c = r['Category']\n",
        "    doc = nlp(str(r['Text']))\n",
        "\n",
        "    # mod 4 pos tagging and style extraction\n",
        "    for t in doc:\n",
        "        pos_map[c][t.pos_] += 1\n",
        "        # mod 5 syntactic tracking & relationship mappings\n",
        "        dep_relations[f\"{t.dep_} -> {t.head.pos_}\"] += 1\n",
        "\n",
        "    # mod 8 named entities profiling\n",
        "    for e in doc.ents:\n",
        "        if e.label_ in ['PERSON', 'ORG', 'GPE', 'DATE', 'MONEY']:\n",
        "            ner_map[c][e.label_] += 1\n",
        "\n",
        "print(\"\\n--- Mod 5: Top Syntactic Dependency Links Discovered ---\")\n",
        "print(dep_relations.most_common(6))\n",
        "\n",
        "# plot mod 6 sentiment distributions chart\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "plt.figure(figsize=(9, 3.5))\n",
        "sns.boxplot(x='Category', y='sentiment_score', data=df, hue='Category', palette='muted', legend=False)\n",
        "plt.title('Mod 6: Article Sentiment Variance Curves Across Genres')\n",
        "plt.show()\n",
        "\n",
        "# plot mod 4 cross category pos density map (identifies style anomalies)\n",
        "pdf = pd.DataFrame(pos_map).T.fillna(0)\n",
        "pdf_pct = pdf.div(pdf.sum(axis=1), axis=0) * 100\n",
        "plt.figure(figsize=(9, 3.5))\n",
        "sns.heatmap(pdf_pct[['NOUN', 'VERB', 'ADJ', 'PROPN']], annot=True, cmap='Greens', fmt='.1f')\n",
        "plt.title('Mod 4: Style Analysis Matrix (% Grammar Components Per Class)')\n",
        "plt.show()\n",
        "\n",
        "# plot mod 8 ner frequency distributions graph\n",
        "ndf = pd.DataFrame(ner_map).T.fillna(0)\n",
        "plt.figure(figsize=(9, 3.5))\n",
        "sns.heatmap(ndf, annot=True, cmap='Oranges', fmt='.0f')\n",
        "plt.title('Mod 8: Entity Core Correlation Frequency Tracking Grid')\n",
        "plt.show()\n",
        "\n",
        "print(\"done with everything loops complete.\")"
